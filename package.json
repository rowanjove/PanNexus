{
  "name": "pannexus",
  "version": "1.0.0",
  "description": "Next-Gen Federated Cloud Drive & Magnet Indexing Engine (Nuxt 3 + Cloudflare Pages + D1 FTS5)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "db:setup": "wrangler d1 execute metaseek-db --local --file=./database/schema.sql && wrangler d1 execute metaseek-db --local --file=./database/seed.sql",
    "d1:init": "wrangler d1 execute metaseek-db --local --file=./database/schema.sql",
    "d1:migrate": "wrangler d1 execute metaseek-db --local --file=./database/migrations/0003_dedup_and_jobs.sql",
    "d1:seed": "wrangler d1 execute metaseek-db --local --file=./database/seed.sql",
    "crawler:dev": "wrangler dev --config wrangler.crawler.jsonc --test-scheduled",
    "cf:preview": "npx wrangler pages dev dist",
    "deploy:pages": "npx wrangler pages deploy dist",
    "deploy:crawler": "npx wrangler deploy --config wrangler.crawler.jsonc"
  },
  "dependencies": {
    "lucide-vue-next": "^0.475.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@nuxtjs/tailwindcss": "^6.13.1",
    "@types/node": "^22.13.4",
    "nuxt": "^3.15.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6",
    "wrangler": "^3.109.2"
  }
}
